{
  "name": "agentic-sage",
  "version": "1.3.0",
  "type": "module",
  "description": "Passive fleet judge for parallel AI coding agent sessions (Claude Code, Grok Build CLI, etc.) — board, territory, merge briefings, optional live-judge briefs.",
  "bin": {
    "sage": "./bin/sage",
    "agentic-sage": "./bin/sage"
  },
  "files": [
    "bin",
    "lib",
    "hooks",
    "skills",
    "adapters",
    "templates",
    "uninstall",
    "install.mjs",
    "scripts",
    ".grok-plugin",
    ".claude-plugin",
    ".cursor-plugin",
    ".codex-plugin",
    ".agents",
    "docs",
    "AGENTS.md",
    "SETUP.md",
    "ADAPTERS.md",
    "CONVENTIONS.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test",
    "postinstall": "node scripts/postinstall.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:check": "node ../docs-kit/bin/docs-kit.mjs check docs/",
    "docs:health": "node ../docs-kit/bin/docs-kit.mjs health docs/",
    "atlas": "atlas",
    "atlas:gate": "atlas gate",
    "atlas:doctor": "atlas doctor",
    "atlas:wire": "atlas wire all",
    "predev": "atlas gate",
    "mind:check": "atlas check",
    "mind:build": "atlas build",
    "//sage-gate": "global only — sage gate (preferred judge) is machine-level; not chained into predev. run: sage gate",
    "desk:gate": "node scripts/desk-gate.mjs",
    "fleet:desk": "node scripts/fleet-desk-wire.mjs",
    "desk-gate": "node scripts/desk-gate.mjs",
    "fleet-wire-desk": "node scripts/fleet-wire-desk.mjs"
  },
  "author": "Mateusz Muślewski <10kento10@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muslewski/agentic-sage.git"
  },
  "bugs": {
    "url": "https://github.com/muslewski/agentic-sage/issues"
  },
  "homepage": "https://sage.muslewski.com/",
  "keywords": [
    "claude-code",
    "grok",
    "grok-build",
    "agents",
    "fleet",
    "tmux",
    "git-worktree",
    "sessions",
    "orchestration",
    "multi-agent"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "memory-atlas": "^0.5.3"
  }
}
